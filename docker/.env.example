# =============================================================================
# Customer 360 Lakehouse — Environment Variables
# Copy file này thành .env và điền giá trị thực trước khi chạy docker compose
# =============================================================================

# -----------------------------------------------------------------------------
# Oracle XE (Core Banking source)
# -----------------------------------------------------------------------------
ORACLE_USER=core_banking
ORACLE_PASSWORD=CoreBanking123
ORACLE_HOST=oracle
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

# -----------------------------------------------------------------------------
# PostgreSQL (Card/CRM source + Airflow backend + ETL ops)
# -----------------------------------------------------------------------------
POSTGRES_USER=card_crm
POSTGRES_PASSWORD=Cardcrm123
POSTGRES_DB=card_crm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow sẽ dùng DB riêng trên cùng Postgres instance
AIRFLOW_DB=airflow

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=Minioadmin123
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=lakehouse

# -----------------------------------------------------------------------------
# Iceberg REST Catalog
# -----------------------------------------------------------------------------
ICEBERG_REST_HOST=iceberg-rest
ICEBERG_REST_PORT=8181
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3a://lakehouse/lakehouse
# Database PostgreSQL lưu metadata catalog Iceberg (persistent qua restart)
ICEBERG_DB=iceberg_catalog

# -----------------------------------------------------------------------------
# Spark (Standalone cluster — 1 Master + 1 Worker)
# SPARK_WORKER_MEMORY: bộ nhớ worker advertise cho master (cần ≤ container cap - worker JVM ~400m)
#   Container cap = 1600m → max safe = 1200m (1600 - 400 worker daemon)
#   Default 768m executor + 192m overhead = 960m → fit trong 1200m ✓
# SPARK_WORKER_CORES: số cores; spark.cores.max=1 giới hạn mỗi app chỉ dùng 1 core
# Worker-1 UI: http://localhost:9091
# -----------------------------------------------------------------------------
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=9090
SPARK_WORKER_MEMORY=1200m
SPARK_WORKER_CORES=4

# -----------------------------------------------------------------------------
# Trino (Query engine)
# -----------------------------------------------------------------------------
TRINO_HOST=trino
TRINO_PORT=8085

# -----------------------------------------------------------------------------
# Airflow
# FERNET_KEY: generate với: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_KEY: bất kỳ chuỗi random dài ≥ 16 ký tự
# -----------------------------------------------------------------------------
AIRFLOW_FERNET_KEY=-Yb4HMw8ki9asyxEfdY1s2WqX29pLMU5FLJc9DM-uZc=
AIRFLOW_SECRET_KEY=8f7c9ab3f2f9f2d1fbe6f8f3b4e7d8c1a9e7c2d4b5f6a1e3
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_ADMIN_EMAIL=admin@lakehouse.local
